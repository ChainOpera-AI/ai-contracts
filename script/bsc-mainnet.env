# Settled deployment parameters for BSC mainnet. Public addresses only -- no secrets here.
# Load with:  set -a && . script/bsc-mainnet.env && set +a
# Clears the other config's variables. Sourcing both in one shell would otherwise leave
# the first one's still exported, and the deployment would quietly use them instead.
unset MIN_DELAY PROPOSERS EXECUTORS TIMELOCK_ADMIN

# Subscription payments land here. Unchanged from the previous deployment.
RECEIVER=0x466B045700DC241828787adAd35cD868EC041898
# The hot key that calls renew / renewBatch. Unchanged.
FEE_COLLECTOR=0x979e3f3f387680c86EbEA3AB562E8b859bb2C2C1
# May force-cancel a subscription. Unchanged.
TERMINATOR=0x466B045700DC241828787adAd35cD868EC041898
# The only address importAccounts answers to, set by initialize along with every other role.
# Same key as TERMINATOR, which already holds every role on the timelock, so this grants it
# nothing it could not already do.
IMPORTER=0x466B045700DC241828787adAd35cD868EC041898

# Reusing the timelock that owns the previous deployment. Its four roles are held solely by
# 0x466B045700DC241828787adAd35cD868EC041898 (plus itself as admin), and minDelay is 0 --
# which still means schedule() then execute(), two transactions, for every later owner call.
TIMELOCK=0xF08CC96a7877e7E9AD1A087F18fc9d222448B84c

# The implementation deployed on 2026-09-30 in tx 0x7774edec…b0b9. Its runtime code matches the
# local build byte for byte apart from UUPSUpgradeable's __self immutable, which is the
# contract's own address. Reusing it saves ~5M gas on a retry.
# CLEAR THIS if contracts/subscription_fee_collector.sol changes -- otherwise a fresh deploy
# would point a new proxy at stale logic.
IMPL=0xbdb74eb6091d6ca40d46394076d98736a90ab7c5
