# Settled deployment parameters for BSC mainnet. Public addresses only -- no secrets here.
# Load with:  set -a && . script/bsc-mainnet.env && set +a

# Subscription payments land here. Unchanged from the previous deployment.
RECEIVER=0x466B045700DC241828787adAd35cD868EC041898
# The hot key that calls renew / renewBatch. Unchanged.
FEE_COLLECTOR=0x979e3f3f387680c86EbEA3AB562E8b859bb2C2C1
# May force-cancel a subscription. Unchanged.
TERMINATOR=0x466B045700DC241828787adAd35cD868EC041898
# The only address importAccounts answers to. Same key as TERMINATOR, which already holds every
# role on the timelock, so this grants it nothing it could not already do. Not set by the deploy
# script -- it is an owner call and goes through the timelock afterwards.
IMPORTER=0x466B045700DC241828787adAd35cD868EC041898

# Reusing the timelock that owns the previous deployment. Its four roles are held solely by
# 0x466B045700DC241828787adAd35cD868EC041898 (plus itself as admin), and minDelay is 0 --
# which still means schedule() then execute(), two transactions, for every owner call.
TIMELOCK=0xF08CC96a7877e7E9AD1A087F18fc9d222448B84c
