# A throwaway TOSubscription for integration testing. Every role is the deployer key, so one
# wallet can drive the whole contract, and the timelock is a fresh one with all four roles on
# that same key -- the production shape, with no delay and nothing to cancel.
# Load with:  set -a && . script/bsc-to-test.env && set +a
unset OWNER TIMELOCK IMPL

RECEIVER=0x561097298c7BD8385Aa1a462b44d894106449fB1
# Zero: renew / renewBatch open to anyone, which is how the CO contracts run now.
FEE_COLLECTOR=0x0000000000000000000000000000000000000000
TERMINATOR=0x561097298c7BD8385Aa1a462b44d894106449fB1

MIN_DELAY=0
PROPOSERS=0x561097298c7BD8385Aa1a462b44d894106449fB1
EXECUTORS=0x561097298c7BD8385Aa1a462b44d894106449fB1
TIMELOCK_ADMIN=0x561097298c7BD8385Aa1a462b44d894106449fB1

# The implementation the 2026-11-24 test deployment runs (proxy 0x0911F9D1…, timelock
# 0x93a60e3c…), so a further test deployment is two transactions, not three.
# CLEAR THIS if contracts/to_subscription.sol changes.
IMPL=0x91a33924eAabdBbeA2d6C88E5f2D3aB7fF7b0E31

# After deploying, widen the period bounds for debugging if the test needs periods shorter
# than a day: setPeriodBounds(60, 366 days) through the timelock. The default is 1 day.
