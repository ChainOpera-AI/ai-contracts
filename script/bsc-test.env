# A throwaway Subscription for integration testing, alongside the production one in
# bsc-mainnet.env. Every role is the same key, so one wallet can drive the whole contract.
# Load with:  set -a && . script/bsc-test.env && set +a

RECEIVER=0x561097298c7BD8385Aa1a462b44d894106449fB1
FEE_COLLECTOR=0x561097298c7BD8385Aa1a462b44d894106449fB1
TERMINATOR=0x561097298c7BD8385Aa1a462b44d894106449fB1
IMPORTER=0x561097298c7BD8385Aa1a462b44d894106449fB1

# An EOA, not a TimelockController. initialize only requires a non-zero owner, and for a test
# contract a direct owner means changing a price is one transaction rather than schedule() plus
# execute(). It also means there is no delay and no CANCELLER -- never do this in production.
OWNER=0x561097298c7BD8385Aa1a462b44d894106449fB1

# Same implementation the production proxy runs, so this costs one transaction, not two.
IMPL=0xbdb74eb6091d6ca40d46394076d98736a90ab7c5
