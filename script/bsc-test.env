# A throwaway Subscription for integration testing, alongside the production one in
# bsc-mainnet.env. Every role is the same key, so one wallet can drive the whole contract.
# Load with:  set -a && . script/bsc-test.env && set +a
# Clears the other config's variables. Sourcing both in one shell would otherwise leave
# the first one's still exported, and the deployment would quietly use them instead.
unset OWNER TIMELOCK

RECEIVER=0x561097298c7BD8385Aa1a462b44d894106449fB1
FEE_COLLECTOR=0x561097298c7BD8385Aa1a462b44d894106449fB1
TERMINATOR=0x561097298c7BD8385Aa1a462b44d894106449fB1
IMPORTER=0x561097298c7BD8385Aa1a462b44d894106449fB1

# No OWNER, so the script deploys a fresh TimelockController from the four values below and
# makes that the owner -- the same shape as production, which is what makes this a useful
# rehearsal target and lets the parameter console drive it.
# Delay is zero and one key holds every role, so there is no waiting and nothing to cancel:
# the timelock here is a faithful interface, not a real safeguard. Owner calls are still two
# transactions, schedule() then execute(), exactly as in production.
MIN_DELAY=0
PROPOSERS=0x561097298c7BD8385Aa1a462b44d894106449fB1
EXECUTORS=0x561097298c7BD8385Aa1a462b44d894106449fB1
TIMELOCK_ADMIN=0x561097298c7BD8385Aa1a462b44d894106449fB1

# Same implementation the production proxy runs, so this is two transactions, not three.
IMPL=0xbdb74eb6091d6ca40d46394076d98736a90ab7c5
