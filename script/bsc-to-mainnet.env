# Production parameters for TOSubscription on BSC mainnet. FILL IN before use: the script
# refuses to run on the placeholders below. Public addresses only -- no secrets here.
# Load with:  set -a && . script/bsc-to-mainnet.env && set +a
unset MIN_DELAY PROPOSERS EXECUTORS TIMELOCK_ADMIN IMPL

# Where subscription payments land.
RECEIVER=<fill-in>
# Who may call renew / renewBatch. Zero opens them to anyone (any backend address, cron or
# keeper can collect); name an address to restrict it.
FEE_COLLECTOR=0x0000000000000000000000000000000000000000
# May force-cancel a subscription, writing its arrears off.
TERMINATOR=<fill-in>

# The TimelockController that owns the contract. Deploy a separate one for TeamilyOpera
# rather than reusing ChainOpera's, so the two products' governance stay apart:
#   forge create node_modules/@openzeppelin/contracts/governance/TimelockController.sol:TimelockController \
#     --rpc-url bsc --account <keystore> --broadcast \
#     --constructor-args <minDelay> "[<proposer>]" "[<executor>]" <admin>
OWNER=<fill-in>
